{
  "name": "consorcio-web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "node scripts/apply-patches.mjs",
    "dev": "vite",
    "build": "node scripts/gen-version.mjs && tsc && vite build",
    "gen:version": "node scripts/gen-version.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e:prod": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:canary": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/mapa-maplibre.spec.ts tests/e2e/mapa-viewport-movil.spec.ts tests/e2e/ficha-territorial.spec.ts tests/e2e/mapa-hazard-citizen.spec.ts",
    "test:e2e:rainfall": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/rainfall-v2-detail.spec.ts",
    "test:e2e:rainfall-harness": "playwright test -c tests/e2e/playwright.rainfall-harness.config.ts tests/e2e/rainfall-v2-detail.spec.ts",
    "test:e2e:local": "playwright test -c tests/e2e/playwright.local.config.ts",
    "test:a11y": "playwright test -c tests/accessibility/playwright.config.ts",
    "test:smoke": "vitest run tests/unit/api.test.ts",
    "test:pages-routing": "node scripts/check-pages-routing.mjs",
    "mutation:run": "stryker run",
    "generate:types": "npm exec --yes --legacy-peer-deps --package=openapi-typescript@7.13.0 -- openapi-typescript http://localhost:8000/openapi.json -o ./src/types/schema.d.ts",
    "gen:pmtiles": "tippecanoe -o public/data/suelos_cu.pmtiles -z12 -Z6 --force --layer=suelos_cu public/data/suelos_cu.geojson && tippecanoe -o public/data/catastro_rural_cu.pmtiles -z14 -Z8 --force --layer=catastro_rural_cu public/data/catastro_rural_cu.geojson && tippecanoe -o public/waterways/rio_tercero.pmtiles -z14 -Z8 --force --layer=rio_tercero public/waterways/rio_tercero.geojson && tippecanoe -o public/waterways/arroyo_algodon.pmtiles -z14 -Z8 --force --layer=arroyo_algodon public/waterways/arroyo_algodon.geojson && tippecanoe -o public/waterways/canal_desviador.pmtiles -z14 -Z8 --force --layer=canal_desviador public/waterways/canal_desviador.geojson && tippecanoe -o public/waterways/canal_litin_tortugas.pmtiles -z14 -Z8 --force --layer=canal_litin_tortugas public/waterways/canal_litin_tortugas.geojson && tippecanoe -o public/waterways/arroyo_las_mojarras.pmtiles -z14 -Z8 --force --layer=arroyo_las_mojarras public/waterways/arroyo_las_mojarras.geojson"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@logtail/browser": "^0.5.12",
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/dropzone": "9.7.2",
    "@mantine/form": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@mapbox/mapbox-gl-draw": "^1.5.2",
    "@sentry/react": "^11.7.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@turf/area": "^7.4.0",
    "@turf/center-of-mass": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/midpoint": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "dayjs": "^1.11.23",
    "jszip": "^3.10.2",
    "maplibre-gl": "6.14.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "happy-dom": "^21.0.1",
    "oxc-transform-react": "^0.152.0",
    "typescript": "^7.0.2",
    "typescript-for-stryker": "npm:typescript@6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "qs": "6.16.0"
  }
}
