VITE_API_URL=http://localhost:8000

# --- Multi-Hazard viewer (operator-only) ---
# Set to "true" to enable the Multi-Hazard mode toggle for admin/operador users.
# Citizens and anonymous visitors never see the toggle regardless of this flag.
VITE_FEATURE_MULTI_HAZARD_VIEWER=false

# --- E2E tests (Playwright) ---
# Credenciales de admin para los e2e autenticados (login-flow, auth-protected-flow).
# Si no se setean, esos tests se auto-skipean. NUNCA hardcodear en los specs.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
