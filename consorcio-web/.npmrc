# Cloudflare Pages puede dejar NODE_ENV=production durante `npm ci`. En ese
# modo npm omite devDependencies y `npm run build` muere porque no están
# tsc ni vite. `include` gana sobre `omit`, así que el toolchain se instala
# igual. El build sigue viendo NODE_ENV=production.
include=dev

# Si el dashboard pisa .node-version (26.13.0) con una versión más baja, un
# aviso de engines no tiene que cortar el install.
engine-strict=false
