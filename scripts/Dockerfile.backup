# Tiny image bundling the deps the backup scripts need.
# Built and run by the ``backup-postgres`` / ``backup-volumes`` services
# in docker-compose.prod.yml and docker-compose.deploy.yml (profile: backup).
#
# Operators trigger a backup with:
#   docker compose --profile backup run --rm backup-postgres
#   docker compose --profile backup run --rm backup-volumes
#
# INF-12: Alpine 3.22 (3.20 is out of support). postgresql16-client is still
# packaged there and matches the PostgreSQL 16 server. pg_dump from 16 can
# dump that server; the image is pinned by digest.

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache \
      bash \
      coreutils \
      zstd \
      openssl \
      postgresql16-client \
      restic \
      openssh-client \
      sshpass \
      python3 \
      py3-pip \
      ca-certificates

# Backblaze B2 CLI. ``--break-system-packages`` because Alpine 3.22
# ships PEP 668 and we have no other Python on the image to pollute.
RUN pip install --break-system-packages --no-cache-dir 'b2>=4.0.0'

WORKDIR /opt/backup
COPY backup_postgres.sh backup_volumes.sh /opt/backup/
RUN chmod +x /opt/backup/backup_postgres.sh /opt/backup/backup_volumes.sh

# Default command is a no-op — the compose service overrides it with
# the specific backup script per invocation.
CMD ["/bin/bash", "-lc", "echo 'override CMD with the backup script you want'"]
