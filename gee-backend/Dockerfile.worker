# ==============================================
# Celery Worker + Beat - GDAL + geo deps
# ==============================================

FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.3

WORKDIR /app

# Install Python pip and build essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install ALL dependencies (backend lock + geo). The hashed lock is a full
# closure; --no-deps honours Wave C5's sqlalchemy 2.1 override past
# fastapi-users-db-sqlalchemy's <2.1 metadata pin (see overrides.txt).
COPY requirements.lock requirements-geo.txt ./
# Force pip to ignore system numpy (installed by debian, cannot be upgraded)
RUN pip install --no-cache-dir --break-system-packages --ignore-installed numpy \
        --no-deps --require-hashes -r requirements.lock \
    && pip install --no-cache-dir --break-system-packages --ignore-installed numpy \
        -r requirements-geo.txt

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./

# Create data directory for geo processing outputs
RUN mkdir -p /data/geo

# Create non-root user (mirrors gee-backend/Dockerfile production stage)
# /app + /data/geo writable (raster/geo outputs; volume ownership applies on first init)
RUN addgroup --system app && adduser --system --ingroup app app \
    && chown -R app:app /app /data/geo

# No EXPOSE, no HEALTHCHECK — worker has no HTTP

# Switch to non-root user
USER app

CMD ["celery", "-A", "app.core.celery_app", "worker", "--beat", "--loglevel=info", "--concurrency=2", "-Q", "celery,geo"]
