# ====================================================
# Consorcio Canalero - Variables de Produccion
# ====================================================
# Frontend: Cloudflare Pages (vars se configuran en el dashboard de CF, no aca)
# Backend + geo-worker + Martin: Docker en Hetzner
#
# Copiá este archivo a /home/javier/stacks/consorcio/.env
# y completá los valores reales antes de levantar el stack.
# NUNCA comitees el .env con valores reales.
#
# Variables para Cloudflare Pages (configurar en CF dashboard):
#   VITE_API_URL    = https://api.consorcio.DOMINIO
#   VITE_MARTIN_URL = https://tiles.consorcio.DOMINIO
# ====================================================

# --- Entorno ---
# Activa los gates de seguridad fail-fast en app/config.py:
#   - rechaza JWT_SECRET placeholder / corto (<64 bytes)
#   - rechaza REDIS_PASSWORD='changeme'
#   - rechaza RATE_LIMIT_DISABLED truthy
#   - rechaza CORS_ORIGINS con '*' o localhost
ENVIRONMENT=production

# --- Imagenes Docker (GHCR) ---
# En produccion SIEMPRE pinear a un SHA especifico, NO usar :latest.
# El workflow .github/workflows/deploy.yml publica cada commit a main con
# DOS tags: el SHA corto (ej. 1cbfc8a) y :latest. Pinear al SHA permite:
#   - Rollback en 1 comando: cambiar el SHA aca, `docker compose pull && up -d`
#   - Auditoria: saber exactamente que codigo esta corriendo
#   - Inmutabilidad: :latest se pisa solo, el SHA NO
#
# Para hacer rollback al SHA anterior:
#   1. Buscar el SHA en
#      https://github.com/JNZader/consorcio-canalero/pkgs/container/consorcio-canalero%2Fbackend
#   2. Cambiar las dos lineas abajo al SHA que queres
#   3. `docker compose pull backend geo-worker && docker compose up -d backend geo-worker celery-worker`
BACKEND_IMAGE=ghcr.io/jnzader/consorcio-canalero/backend:CAMBIAR_AL_SHA_DEL_DEPLOY
GEO_WORKER_IMAGE=ghcr.io/jnzader/consorcio-canalero/geo-worker:CAMBIAR_AL_SHA_DEL_DEPLOY

# --- Base de datos (PostgreSQL compartido = shared-postgres) ---
# El nombre de la DB en produccion es consorcio_canalero (distinto al dev = consorcio)
DATABASE_URL=postgresql+asyncpg://consorcio:CAMBIAR_PASSWORD_CONSORCIO@shared-postgres:5432/consorcio_canalero

# --- Redis (compartido = shared-redis, db0 para consorcio) ---
REDIS_URL=redis://:CAMBIAR_PASSWORD_REDIS@shared-redis:6379/0
# REDIS_PASSWORD es el password 'plano' — chequeado por el fail-fast aparte
# del REDIS_URL para detectar 'changeme' incluso si el URL lo enmascara.
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS

# --- JWT ---
# Generar con: openssl rand -hex 32  (produce 64 caracteres hex = 32 bytes binarios)
# El fail-fast rechaza <64 bytes UTF-8 y el placeholder default.
JWT_SECRET=CAMBIAR_CON_openssl_rand_hex_32

# --- Rate limiting ---
# Default false en prod. El fail-fast aborta el boot si esto queda truthy
# en production/staging. Solo poner 'true' en dev/E2E.
RATE_LIMIT_DISABLED=false

# --- Google OAuth (opcional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Earth Engine (opcional) ---
GEE_PROJECT_ID=cc10demayo
GEE_SERVICE_ACCOUNT_KEY=

# --- CORS (Cloudflare Pages acepta requests desde este origen) ---
# Incluir tanto el dominio propio como el .pages.dev por si acaso.
# El fail-fast rechaza '*', vacio o entradas localhost en production.
CORS_ORIGINS=https://consorcio.DOMINIO,https://consorcio-canalero.pages.dev

# --- Martin (URLs para el backend) ---
MARTIN_INTERNAL_URL=http://consorcio-martin:3000
MARTIN_PUBLIC_URL=https://tiles.consorcio.DOMINIO

# --- Geo Worker (URL interna) ---
GEO_WORKER_TILE_URL=http://consorcio-geo-worker:8001

# --- Sentry (error tracking) — OPTIONAL ---
# Free tier: 5k errors/mes en https://sentry.io. Crear proyecto:
#   1. Signup / login en sentry.io
#   2. Crear nuevo proyecto, plataforma: "FastAPI" (backend) y "React" (frontend)
#   3. Copiar el DSN del proyecto FastAPI aca, y el DSN del proyecto React
#      como variable de entorno VITE_SENTRY_DSN en Cloudflare Pages.
# Si dejas SENTRY_DSN vacio el init en app/main.py es un no-op silencioso.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_ENVIRONMENT cae a ENVIRONMENT cuando esta vacio
SENTRY_ENVIRONMENT=

# --- BetterStack / Logtail (logs centralizados) — OPTIONAL ---
# Free tier: 1 GB/mes en https://betterstack.com. Crear source:
#   1. Signup / login en betterstack.com → Logs (logs.betterstack.com)
#   2. Sources → Connect source → "FastAPI" (backend) y "JavaScript /
#      Browser" (frontend). Copiar el "Source token" de cada uno.
# Dejar BETTERSTACK_TOKEN vacio para no shipear logs off-box.
BETTERSTACK_TOKEN=
# Opcional: solo si usas la region EU (default = US).
# EU: https://eu1.logs.betterstack.com
BETTERSTACK_HOST=

# --- App ---
DEBUG=false
ENABLE_DOCS=false
FRONTEND_URL=https://consorcio.DOMINIO
API_BASE_URL=https://api.consorcio.DOMINIO

# --- Martin DB URL (sin +asyncpg, para el martin-config.yaml) ---
MARTIN_DB_URL=postgresql://consorcio:CAMBIAR_PASSWORD_CONSORCIO@shared-postgres:5432/consorcio_canalero
