#!/bin/bash
# Pre-push: hybrid Node+Python runners from .javi-forge/ci.yaml.
# Always --no-docker: a Node container has no Make/Python (issue #164).
# Install: make install-hooks
# To skip: git push --no-verify
set -e

run_quick_checks() {
  if command -v javi-forge &>/dev/null; then
    javi-forge ci --quick --no-docker --no-security --no-ci-ghagga
  else
    npx javi-forge ci --quick --no-docker --no-security --no-ci-ghagga
  fi
}

echo "PRE-PUSH: configured runners, native (no Node Docker image)"
run_quick_checks || {
  echo ""
  echo "QUICK CHECKS FAILED — push aborted. Fix the issues above."
  echo "To skip: git push --no-verify"
  exit 1
}
